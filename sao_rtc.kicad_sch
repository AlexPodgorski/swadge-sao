	(text "Temperature Test Jumper\n10k @ 25C\n~27k @ 0C\n~5k @ 55C\n\n1-2 For Normal Operation\n2-3 For High Temp Trip\nRemove jumper for Low Temp Trip\nInstall actual 10k NTC between\npins 2&3 for real response"
		(exclude_from_sim no)
		(at 370.84 132.08 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "46fb3ee4-8d2c-4570-8716-31b91b433cc2")
	)
	(text "RT1/RT2 can be set to values for other NTC curves\n\n5.25k & 31.23k nominal,\nRounted to 5.36 & 31.6k\nsince those are the nearest\n1% values that I saw in stock"
		(exclude_from_sim no)
		(at 322.58 144.78 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "4e6e1af9-1dce-4b5c-9a07-5fd0882ea0d6")
	)
